# ---------------------------------------------------------------------------
# Sync — repository ignore rules
# ---------------------------------------------------------------------------

# Local environment files (never commit real secrets). docker/.env is created
# locally from docker/.env.example by the operator and is never tracked.
.env
.env.local
docker/.env
docker/.env.local

# Go build artifacts
/bin/
/dist/
/sync
*.test
*.out
coverage.txt

# Node / Vite
web/node_modules/
web/dist/*
!web/dist/.gitkeep
web/.vite/
web/.eslintcache
npm-debug.log*
yarn-error.log*

# Editors & OS noise
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~

# Temporary / scratch
/tmp/
/.cache/
