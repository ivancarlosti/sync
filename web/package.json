{
  "name": "sync-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sync \u2014 Vue 3 SPA embedded into the Go binary",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "node scripts/check-i18n.mjs && vue-tsc --noEmit && vue-tsc --noEmit -p tsconfig.node.json",
    "build": "npm run typecheck && vite build",
    "postbuild": "node scripts/restore-dist-placeholder.mjs",
    "preview": "vite preview",
    "screenshots": "node scripts/capture-screenshots.mjs"
  },
  "dependencies": {
    "@lucide/vue": "1.57.0",
    "axios": "1.20.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "pinia": "4.1.0",
    "reka-ui": "2.11.0",
    "tailwind-merge": "3.7.0",
    "vue": "3.5.44",
    "vue-i18n": "11.4.14",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.5",
    "@vitejs/plugin-vue": "6.0.10",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vue-tsc": "3.3.13"
  },
  "overrides": {
    "postcss-selector-parser": "7.1.6",
    "source-map-js": "1.2.2"
  }
}
