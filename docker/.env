# =============================================================================
#  Sync — environment file used by docker/docker-compose.yml
#
#  DEVELOPMENT DEFAULTS. Before exposing this instance to anyone:
#    1. replace ENCRYPTION_KEY with your own `openssl rand -base64 32`;
#    2. change ACCOUNT_PASSWORD (and ACCOUNT_LOGIN);
#    3. set the real DB credentials of your external MariaDB/MySQL server;
#    4. set APP_URL to the public https URL.
#  Full reference: ../docker/.env.example and ../docs/development.md
# =============================================================================

# App & reverse proxy
APP_URL=http://localhost:3000
APP_TRUST_PROXY=true
APP_PORT=3000
LOG_LEVEL=info

# Database (external MariaDB/MySQL, reached through the Docker host gateway)
DB_HOST=host.docker.internal
DB_PORT=3306
DB_DATABASE=sync
DB_USERNAME=sync
DB_PASSWORD=secret
DB_SSL=false

# Security (32-byte AES-256 key — regenerate with `openssl rand -base64 32`)
ENCRYPTION_KEY=S1SbU3fXJy7l0zF95oQa3oHgAEF09hGqkaLcwLmQ88Q=

# Authentication: none | account | keycloak
AUTH_METHOD=account
ACCOUNT_LOGIN=admin@example.com
ACCOUNT_PASSWORD=admin123
RECAPTCHA_CLIENTID=
RECAPTCHA_CLIENTSECRET=

KEYCLOAK_BASE_URL=https://sso.example.com
KEYCLOAK_REALM=sync-realm
KEYCLOAK_CLIENT_ID=sync-client
KEYCLOAK_CLIENT_SECRET=YOURSECRET
KEYCLOAK_REDIRECT_URI=
KEYCLOAK_ACCOUNTS=admin@example.com @empresa.com domain2.com

# OAuth providers (empty = provider disabled in the UI)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=

# I18n & theme
DEFAULT_LOCALE=en-US
DEFAULT_THEME=system
