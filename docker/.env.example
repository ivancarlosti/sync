# =============================================================================
#  Sync — environment template (copy to .env and edit)
#  Every variable below is read and validated at boot; missing required values
#  abort the start with an explicit message listing what is wrong.
#
#  This file deliberately contains NO usable secrets. The app refuses to start
#  while ENCRYPTION_KEY, ACCOUNT_PASSWORD or DB_PASSWORD are empty, so an
#  unedited copy can never run with a key or password published in this
#  repository.
# =============================================================================

# -----------------------------------------------------------------------------
# App & reverse proxy
# -----------------------------------------------------------------------------
# Public canonical URL of the instance. It is used to build OAuth/OIDC redirect
# URIs, absolute links and the CORS allow-list. No trailing slash.
APP_URL=https://sync.example.com
# Trust X-Forwarded-For / X-Forwarded-Proto / X-Forwarded-Host from the reverse
# proxy in front of Sync. Set to false when the container is exposed directly.
APP_TRUST_PROXY=true
# Internal listening port (must match the published port in docker-compose.yml).
APP_PORT=3000
# Optional: log level — debug | info | warn | error (default: info).
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Database — MariaDB / MySQL (EXTERNAL, never started by this repository)
# -----------------------------------------------------------------------------
DB_HOST=host.docker.internal
DB_PORT=3306
DB_DATABASE=sync
DB_USERNAME=sync
# Required: the password of the database user (never commit the real value).
DB_PASSWORD=
# true to force TLS to the database server (required by most managed services).
DB_SSL=false

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# Required: 32-byte AES-256 master key. Generate a private value with:
#   openssl rand -base64 32
# Accepted formats: base64 (44 chars), 64 hex chars or 32 raw characters.
# Never reuse a value from this template, the documentation or a public repo:
# the key encrypts the stored tokens and derives the session/state signatures.
ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Authentication — none | account | keycloak
# -----------------------------------------------------------------------------
AUTH_METHOD=account

# account mode -----------------------------------------------------------------
ACCOUNT_LOGIN=admin@example.com
# Required: at least 12 characters, must differ from the login and must not be
# a publicly known default (admin123, changeme, password, ...).
ACCOUNT_PASSWORD=
# Optional: leave both empty to disable the captcha on the login form.
RECAPTCHA_CLIENTID=
RECAPTCHA_CLIENTSECRET=

# keycloak (OIDC) mode ---------------------------------------------------------
KEYCLOAK_BASE_URL=https://sso.example.com
KEYCLOAK_REALM=sync-realm
KEYCLOAK_CLIENT_ID=sync-client
# Required in keycloak mode: the client secret from the Keycloak console.
KEYCLOAK_CLIENT_SECRET=
# Leave empty to derive it automatically from APP_URL.
KEYCLOAK_REDIRECT_URI=${APP_URL}/api/auth/callback
# Allow-list: exact e-mails (you@example.com), whole domains (@empresa.com,
# empresa.com) or a bare domain (domain2.com). Space or comma separated.
KEYCLOAK_ACCOUNTS=admin@example.com @empresa.com domain2.com

# -----------------------------------------------------------------------------
# OAuth providers — created by the admin, see docs/providers.md
# Leave empty to keep a provider disabled (the UI links to the docs instead of
# offering the "Add account" action).
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=${APP_URL}/api/oauth/google/callback

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# common | organizations | consumers | <tenant-uuid>
# Leave it on common for a multi-tenant registration: any directory can be
# connected and every directory administrator grants the consent once for their
# own directory. A tenant UUID or a verified domain locks the client to one
# directory. The consent step uses organizations for the generic values, which is
# what Microsoft documents for the adminconsent endpoint.
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=${APP_URL}/api/oauth/microsoft/callback

# -----------------------------------------------------------------------------
# I18n & theme
# -----------------------------------------------------------------------------
# en-US | pt-BR | es-MX | fr-FR | h-CN | hi-IN | ar-SA
DEFAULT_LOCALE=en-US
# light | dark | system
DEFAULT_THEME=system

# -----------------------------------------------------------------------------
# Notifications — see docs/notifications.md
# -----------------------------------------------------------------------------
# A webhook channel normally has to point at a publicly routable address: the
# delivery worker runs inside this container, so a private destination would let
# a stored channel reach the API itself, the database, another container or the
# cloud metadata endpoint (169.254.169.254). Set this to true only to deliver to
# a target on your own network (Gotify, ntfy, Home Assistant, another container
# or a Tailscale address).
NOTIFY_ALLOW_PRIVATE_TARGETS=false
